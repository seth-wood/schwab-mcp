{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schwab-mcp-seth",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "migrations": [
    {
      "new_sqlite_classes": [
        "MyMCP"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "50101d649a934492a6a484e2dbba4866"
    }
  ],
  "observability": {
    "enabled": false
  }
}
